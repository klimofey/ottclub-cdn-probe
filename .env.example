# Copy to .env and fill in. Nothing else is required: the container finds
# your playlist link and the list of CDNs by itself after logging in.

# Which panel to log into. Several resellers run the same software.
PANEL_URL=https://ilook.tv

ILOOK_EMAIL=you@example.com
ILOOK_PASSWORD=your-password

# Gap between full rounds: none | manual | 30m | 1h | 3600
ROUND_PAUSE=none

# Only test during these hours, so the account stays watchable the rest of
# the day. This is what makes it tolerable to point at a playlist you use.
# Wraps past midnight. Empty = no restriction.
ACTIVE_HOURS=01:00-07:00
TZ=Asia/Jerusalem

# Switch the account to the best proven CDN when a round finishes.
# Only a CDN with a "solid" verdict qualifies.
AUTO_APPLY=false

# Dashboard port on the host.
WEB_PORT=8080

# Retention. Old rounds are dropped by age first: CDN quality drifts, so a
# month-old measurement blurs today's median rather than informing it.
# HISTORY_DAYS=30
# HISTORY_MAX_RECORDS=20000

# Measurement tuning (optional).
# DISCOVERY_ROUNDS=20    balancer polls per channel; more = better weighting
# CHANNELS=2             channels sampled per round
# EDGE_CAP_SECONDS=3.0   per-edge download cap
# EDGE_CAP_MB=6
